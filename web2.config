<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
    <handlers>
      <remove name="WebDAV" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />

      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpErrors existingResponse="PassThrough" />

        <httpPlatform processPath="C:\edms\edms_api\venv\Scripts\python.exe"
                        arguments="-m uvicorn app:app --host 0.0.0.0 --port %HTTP_PLATFORM_PORT%"
                        stdoutLogEnabled="true"
                        stdoutLogFile=".\logs\python-stdout.log"
                        startupTimeLimit="300"
                        requestTimeout="00:20:00"
                        processesPerApplication="4">
            <environmentVariables>
                <environmentVariable name="PYTHONPATH" value="C:\edms\edms_api" />
                <environmentVariable name="WSDL_URL" value="" />
                <environmentVariable name="DMS_USER" value="smartedms" />
                <environmentVariable name="DMS_PASSWORD" value="" />
                <environmentVariable name="DB_HOST" value="" />
                <environmentVariable name="DB_PORT" value="" />
                <environmentVariable name="DB_SERVICE_NAME" value="" />
                <environmentVariable name="DB_USERNAME" value="" />
                <environmentVariable name="DB_PASSWORD" value="" />
                <environmentVariable name="CAPTIONING_API_URL" value="http://localhost:5001" />
                <environmentVariable name="OCR_API_URL" value="http://localhost:5004" />
                <environmentVariable name="FACE_API_URL" value="http://localhost:5002" />
                <environmentVariable name="VIDEO_SUMMARIZER_API_URL" value="http://localhost:5008" />
                <environmentVariable name="TRANSLATOR_REPHRASER_API_URL" value="http://localhost:5005" />
                <environmentVariable name="DMS_GROUP_REFRESH_TIMEOUT_SECONDS" value="5" />
                <environmentVariable name="AUTH_DB_TIMEOUT_SECONDS" value="5" />
                <environmentVariable name="WSDL_LOAD_TIMEOUT_SECONDS" value="10" />
                <environmentVariable name="WSDL_OPERATION_TIMEOUT_SECONDS" value="15" />

                <!-- Multi-Node / Load-Balanced: shared file-based state via UNC admin share -->
                <!-- Both nodes use the SAME UNC path so they read/write the same files. -->
                <!-- For local dev, change \\10.11.23.43\c$\edms-shared back to d:\edms-shared -->
                <environmentVariable name="CHROMA_DB_PATH" value="\\rtaedmsdm1\DMSAN\smart_edms\chroma_db" />
                <environmentVariable name="PROCESSING_QUEUE_DB_PATH" value="\\rtaedmsdm1\DMSAN\smart_edms\processing_queue.sqlite3" />
                <environmentVariable name="IDEMPOTENCY_DB_PATH" value="\\rtaedmsdm1\DMSAN\smart_edms\idempotency.sqlite3" />
                <environmentVariable name="THUMBNAIL_CACHE_DIR" value="\\rtaedmsdm1\DMSAN\smart_edms\thumbnail_cache" />
                <environmentVariable name="VIDEO_CACHE_DIR" value="\\rtaedmsdm1\DMSAN\smart_edms\video_cache" />
                <environmentVariable name="TEMP_THUMBNAIL_CACHE_DIR" value="\\rtaedmsdm1\DMSAN\smart_edms\temp_thumbnail_cache" />
                <environmentVariable name="DOWNLOAD_CACHE_DIR" value="\\rtaedmsdm1\DMSAN\smart_edms\download_cache" />

                <!-- Leader election: prevents duplicate background work across nodes -->
                <environmentVariable name="WORKER_ROLE" value="auto" />
                <environmentVariable name="WORKER_LEASE_DIR" value="\\rtaedmsdm1\DMSAN\smart_edms\" />
                <environmentVariable name="WORKER_LEASE_TTL" value="30" />
                <environmentVariable name="WORKER_LEASE_RENEW_INTERVAL" value="10" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>
